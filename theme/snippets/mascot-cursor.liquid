<style>
  #pico-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 42px;
    height: auto;
    overflow: visible; /* let the SVG's baked-in drop shadow spill past the box */
    margin: 4px 0 0 4px; /* nudge below-right of the real pointer tip */
    pointer-events: none;
    z-index: 99999;
    opacity: 0;
    will-change: transform;
    transition: opacity 0.25s ease;
  }
  #pico-cursor.is-visible { opacity: 1; }
  #pico-cursor svg { width: 100%; height: auto; display: block; overflow: visible; }

  /* No cursor on touch devices; honour reduced-motion preference. */
  @media (hover: none), (pointer: coarse) {
    #pico-cursor { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    #pico-cursor { display: none; }
  }
</style>

<script>
  (function () {
    var fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!fine || calm) return;

    var pico = document.getElementById('pico-cursor');
    if (!pico) return;

    var targetX = window.innerWidth / 2;
    var targetY = window.innerHeight / 2;
    var x = targetX;
    var y = targetY;
    var ease = 0.28; // lower = lazier trail
    var seen = false;
    var raf;

    function onMove(e) {
      targetX = e.clientX;
      targetY = e.clientY;
      if (!seen) {
        seen = true;
        pico.classList.add('is-visible');
      }
    }

    function tick() {
      x += (targetX - x) * ease;
      y += (targetY - y) * ease;
      pico.style.transform = 'translate(' + x + 'px, ' + y + 'px)';
      raf = window.requestAnimationFrame(tick);
    }

    window.addEventListener('mousemove', onMove, { passive: true });
    document.addEventListener('mouseleave', function () { pico.classList.remove('is-visible'); });
    document.addEventListener('mouseenter', function () { if (seen) pico.classList.add('is-visible'); });
    raf = window.requestAnimationFrame(tick);
  })();
</script>
