<!-- /snippets/cart-bar.liquid -->

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign blocks_form = section.blocks | where: 'type', 'form'
  assign button_add = false

  if product.has_only_default_variant
    assign button_add = true
  endif

  comment
    Collection Sale (display only): mirror the faked discount from price.liquid
    so the sticky cart bar price matches the product page and Add to Cart button.
  endcomment
  assign cb_summer_active = false
  if settings.summer_sale_enabled and settings.summer_sale_discount > 0 and settings.summer_sale_collection != blank
    for sale_collection in product.collections
      if sale_collection.id == settings.summer_sale_collection.id
        assign cb_summer_active = true
      endif
    endfor
  endif

  assign cb_sitewide_active = false
  if settings.sitewide_sale_enabled and settings.sitewide_sale_discount > 0
    assign cb_sitewide_active = true
  endif

  assign cb_raw_price = current_variant.price
  assign cb_raw_compare = current_variant.compare_at_price
  assign cb_on_sale = false
  if cb_summer_active or cb_sitewide_active
    if current_variant.price > 0
      assign cb_sale_price = current_variant.price
      if cb_summer_active
        assign cb_multiplier = 100 | minus: settings.summer_sale_discount
        assign cb_sale_price = cb_sale_price | times: cb_multiplier | divided_by: 100
      endif
      if cb_sitewide_active
        assign cb_multiplier = 100 | minus: settings.sitewide_sale_discount
        assign cb_sale_price = cb_sale_price | times: cb_multiplier | divided_by: 100
      endif
      assign cb_raw_compare = current_variant.price
      assign cb_raw_price = cb_sale_price
      assign cb_on_sale = true
    endif
  elsif current_variant.compare_at_price > current_variant.price
    assign cb_on_sale = true
  endif

  if settings.currency_code_enable
    assign current_variant_price = cb_raw_price | money_with_currency
    assign current_variant_compare_at_price = cb_raw_compare | money_with_currency
  else
    assign current_variant_price = cb_raw_price | money
    assign current_variant_compare_at_price = cb_raw_compare | money
  endif

  assign any_variant_available = false
  for option in product.options_with_values
    for option_value in option.values
      if option_value.available
        assign any_variant_available = true
        break
      endif
    endfor
  endfor
-%}

{%- render 'stylesheet', name: 'cart-bar.css' -%}

{%- style -%}
  :root {
    --cart-bar-height: 80px;
  }
{%- endstyle -%}

<script src="{{ 'cart-bar.js' | asset_url }}" defer="defer"></script>

<cart-bar id="CartBar-{{ section.id }}" class="cart-bar">
  <div
    class="cart-bar__form__wrapper form__wrapper{% if button_add and current_variant.available != true %} variant--soldout{% endif %}{% if settings.show_newsletter %} show-product-notification{% endif %}{% unless any_variant_available %} all-variants--soldout{% endunless %}"
    data-form-wrapper
  >
    <div class="cart-bar__info">
      <h4 class="cart-bar__product__title">{{ product.title | strip_html }}</h4>

      <div class="body-small cart-bar__product__price product__price">
        <span
          data-product-price
          {% if cb_on_sale %}
            class="product__price--sale"
          {% endif %}
        >
          {%- if cb_raw_price == 0 -%}
            {{ 'general.money.free' | t }}
          {%- else -%}
            {{ current_variant_price }}
          {%- endif -%}
        </span>

        {% if cb_on_sale %}
          <span class="visually-hidden" data-compare-text>{{ 'products.product.regular_price' | t }}</span>
          <s class="product__price--strike">
            {{ current_variant_compare_at_price }}
          </s>
        {% endif %}
      </div>
    </div>

    <div class="cart-bar__form">
      <div class="cart-bar__submit product__submit product__submit--spb">
        <button
          type="button"
          class="btn btn--primary btn--outline product__submit__add{% unless button_add %} product__submit__add--default{% endunless %}"
          {% if button_add %}
            data-cart-bar-add-to-cart
          {% elsif any_variant_available %}
            data-cart-bar-scroll
          {% endif %}
          {% if any_variant_available == false or button_add and current_variant.available != true %}
            disabled="disabled"
          {% endif %}
        >
          <span
            class="btn__text"
            {% if button_add %}
              data-add-to-cart-text
            {% endif %}
          >
            {%- if button_add -%}
              {%- assign preorder_check = false -%}

              {%- if product.tags contains '_preorder' or product.metafields.theme.preorder.value -%}
                {%- assign preorder_check = true -%}
              {%- endif -%}

              {%- if current_variant.available and preorder_check -%}
                {{ 'products.product.pre_order' | t }}
              {%- elsif current_variant.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            {%- elsif any_variant_available -%}
              {{ 'products.product.configure' | t }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </span>

          <span class="btn__loader">
            <svg height="18" width="18" class="svg-loader">
              <circle r="7" cx="9" cy="9" />
              <circle stroke-dasharray="87.96459430051421 87.96459430051421" r="7" cx="9" cy="9" />
            </svg>
          </span>

          <span class="btn__added">&nbsp;</span>

          {%- unless button_add or any_variant_available == false -%}
            {%- render 'icon-nav-arrow-up' -%}
          {%- endunless -%}
        </button>

        {%- if settings.show_newsletter -%}
          {%- assign newsletter_text = 'general.newsletter_form.newsletter_product_availability' | t -%}
          {%- assign newsletter_button_text = 'products.product.sold_out'
            | t
            | append: ' - '
            | append: newsletter_text
          -%}

          <button
            type="button"
            class="btn btn--primary btn--outline product__submit__add product__submit__add--default product__cart-bar-notification-button"
            data-notification-popup-button
          >
            <span class="btn__text">{{ newsletter_button_text }}</span>
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>
</cart-bar>
