{
  "sections": {
    "main": {
      "type": "collection",
      "custom_css": [
        ".collection__products .grid {column-gap: 5px;}"
      ],
      "settings": {
        "enable_sort": true,
        "enable_filters": true,
        "filter_layout": "inline-open",
        "default_open": true,
        "collection_linklist": "minimalist-menu-v2",
        "grid": 4,
        "grid_mobile": "2",
        "products_per_page": 24,
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 60
      }
    },
    "faq": {
      "type": "section-accordion-group",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "title": "Black Friday questions"
          }
        },
        "q_code": {
          "type": "question",
          "settings": {
            "default_open": false,
            "title": "Do I need a discount code?",
            "content": "<p>No code needed. The 40% is already shown on every piece and applied automatically in your cart.</p>",
            "show_icon": false,
            "icon_name": "icon-award",
            "icon_size": 20,
            "icon_color": ""
          }
        },
        "q_dates": {
          "type": "question",
          "settings": {
            "default_open": false,
            "title": "How long does the sale last?",
            "content": "<p>From Friday, November 20 through the end of Tuesday, December 1 — or while sizes last.</p>",
            "show_icon": false,
            "icon_name": "icon-award",
            "icon_size": 20,
            "icon_color": ""
          }
        },
        "q_stack": {
          "type": "question",
          "settings": {
            "default_open": false,
            "title": "Does the 40% apply to items already on sale?",
            "content": "<p>Yes. Clearance pieces get the extra 40% off on top of their sale price — that's our sale on sale.</p>",
            "show_icon": false,
            "icon_name": "icon-award",
            "icon_size": 20,
            "icon_color": ""
          }
        }
      },
      "block_order": [
        "heading",
        "q_code",
        "q_stack",
        "q_dates"
      ],
      "settings": {
        "heading_font_size": "heading-medium",
        "question_font_size": "heading-small",
        "width": "wrapper--narrow",
        "columns": "1",
        "color_scheme": "",
        "padding_top": 20,
        "padding_bottom": 60
      }
    },
