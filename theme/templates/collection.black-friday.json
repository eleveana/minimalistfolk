{
  "sections": {
    "countdown": {
      "type": "section-countdown-timer",
      "blocks": {
        "subheading": {
          "type": "subheading",
          "settings": {
            "subheading": "Nov 27 – Dec 1 · Our biggest sale of the year"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "title": "Black Friday is here. Everything is on sale.",
            "heading_font_size": "heading-large",
            "heading_tag": "h1"
          }
        },
        "timer": {
          "type": "timer",
          "settings": {
            "end_date": "2026/12/01",
            "end_time": "11:59",
            "period": "pm",
            "end_message": "<p>Black Friday has ended. Thank you for shopping with us.</p>",
            "digits_font_size": "heading-x-large",
            "text_font_size": "body-small"
          }
        }
      },
      "block_order": [
        "subheading",
        "heading",
        "timer"
      ],
      "settings": {
        "hide_on_complete": false,
        "width": "wrapper--full-padded",
        "text_align": "text-center",
        "height": "four-fifty-height-hero",
        "mobile_height": "four-fifty-height-hero--mobile",
        "text_align_mobile": "text-center--mobile",
        "color_scheme": "scheme-5",
        "digits_gradient": "",
        "overlay_type": "disabled",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
