        "q_code": {
          "type": "question",
          "settings": {
            "default_open": false,
            "title": "Do I need a discount code?",
            "content": "<p>No code needed. The Black Friday price is already shown on every piece and applied automatically in your cart.</p>",
            "show_icon": false,
            "icon_name": "icon-award",
            "icon_size": 20,
            "icon_color": ""
          }
        },
        "q_dates": {
          "type": "question",
          "settings": {
            "default_open": false,
