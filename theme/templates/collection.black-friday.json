{
  "sections": {
    "main": {
      "type": "collection",
      "custom_css": [
        ".collection__products .grid {column-gap: 5px;}"
      ],
      "settings": {
        "enable_sort": true,
        "enable_filters": true,
        "filter_layout": "inline-open",
        "default_open": true,
        "collection_linklist": "minimalist-menu-v2",
        "grid": 4,
        "grid_mobile": "2",
        "products_per_page": 24,
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 60
      }
    },
    "faq": {
      "type": "section-accordion-group",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "title": "Black Friday questions"
          }
        },
        "q_code": {
          "type": "question",
          "settings": {
            "default_open": false,
            "title": "Do I need a discount code?",
            "content": "<p>No code needed. The Black Friday price is already shown on every piece and applied automatically in your cart.</p>",
            "show_icon": false,
            "icon_name": "icon-award",
            "icon_size": 20,
            "icon_color": ""
          }
        },
        "q_dates": {
          "type": "question",
          "settings": {
            "default_open": false,
            "title": "How long does the sale last?",
            "content": "<p>From Friday, November 20 through the end of Tuesday, December 1 — or while sizes last.</p>",
            "show_icon": false,
            "icon_name": "icon-award",
            "icon_size": 20,
            "icon_color": ""
          }
        }
      },
      "block_order": [
        "heading",
        "q_code",
        "q_dates"
      ],
      "settings": {
        "heading_font_size": "heading-medium",
        "question_font_size": "heading-small",
        "width": "wrapper--narrow",
        "columns": "1",
        "color_scheme": "",
        "padding_top": 20,
        "padding_bottom": 60
      }
    },
    "newsletter": {
      "type": "section-newsletter",
      "blocks": {
        "newsletter": {
          "type": "newsletter",
          "settings": {
            "subheading": "Join our mailing list",
            "heading": "Be first to hear about the next drop",
            "heading_font_size": "heading-small",
            "text": "",
            "text_font_size": "body-medium",
            "text_columns": 1,
            "align_text": "text-center",
            "button_text": "Join",
            "show_arrow": false,
            "terms": false,
            "show_name": false,
            "button_type": "btn--primary",
            "button_size": "",
            "button_style": "btn--solid",
            "show_social_links": false,
            "bg_color": "",
            "color": "",
            "heading_tag": "automatic"
          }
        }
      },
      "block_order": [
        "newsletter"
      ],
      "settings": {
        "width": "wrapper--full-padded",
        "height": "three-fifty-height-hero",
        "mobile_height": "screen-height-one-half--mobile",
        "color_scheme": "scheme-2",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "bf_hero": {
      "type": "bf-hero",
      "settings": {}
    },
    "bf_categories": {
      "type": "bf-categories",
      "blocks": {
        "cat_0": {
          "type": "category",
          "settings": {
            "title": "Tees",
            "collection": "kids-tees",
            "color": "#ecb935"
          }
        },
        "cat_1": {
          "type": "category",
          "settings": {
            "title": "Swim",
            "collection": "ma-me-mi",
            "color": "#de8d9b"
          }
        },
        "cat_2": {
          "type": "category",
          "settings": {
            "title": "Dresses",
            "collection": "dresses",
            "color": "#d1def9"
          }
        },
        "cat_3": {
          "type": "category",
          "settings": {
            "title": "Sweatshirts",
            "collection": "kids-pullovers",
            "color": "#dc954d"
          }
        },
        "cat_4": {
          "type": "category",
          "settings": {
            "title": "Sets",
            "collection": "ss26-part-2",
            "color": "#be979f"
          }
        },
        "cat_5": {
          "type": "category",
          "settings": {
            "title": "Accessories",
            "collection": "two-piece-set",
            "color": "#8b904d"
          }
        }
      },
      "block_order": [
        "cat_0",
        "cat_1",
        "cat_2",
        "cat_3",
        "cat_4",
        "cat_5"
      ],
      "settings": {}
    },
    "bf_perks": {
      "type": "bf-perks",
      "blocks": {
        "perk_0": {
          "type": "perk",
          "settings": {
            "title": "Everything",
            "text": "The whole store is on sale, not a hand-picked rack.",
            "color": "#ecb935"
          }
        },
        "perk_1": {
          "type": "perk",
          "settings": {
            "title": "No code",
            "text": "Sale prices show up on their own. Nothing to type at checkout.",
            "color": "#de8d9b"
          }
        },
        "perk_2": {
          "type": "perk",
          "settings": {
            "title": "Ends Dec 1",
            "text": "Twelve days, then prices go back.",
            "color": "#d1def9"
          }
        },
        "perk_3": {
          "type": "perk",
          "settings": {
            "title": "Free shipping",
            "text": "On domestic orders over $100.",
            "color": "#8b904d"
          }
        }
      },
      "block_order": [
        "perk_0",
        "perk_1",
        "perk_2",
        "perk_3"
      ]
    },
    "bf_list": {
      "type": "bf-product-list",
      "settings": {}
    },
    "bf_band": {
      "type": "bf-cta-band",
      "settings": {}
    }
  },
  "order": [
    "bf_hero",
    "bf_categories",
    "bf_perks",
    "bf_list",
    "main",
    "bf_band",
    "faq",
    "newsletter"
  ]
