<!-- /sections/section-award-badge.liquid -->
{%- comment -%}
  Award badge — a trust/credibility widget pairing an award seal from the Files
  library with a short line of copy. Built for the Inc. 5000 Fastest-Growing
  Companies honour, but kept generic so the badge can be swapped as new awards
  land without touching Liquid.
{%- endcomment -%}

{%- liquid
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign animation_anchor = '#AwardBadge--' | append: section.id
  assign animation_order = 0
  assign layout = section.settings.layout
  assign has_content = false

  if section.settings.subheading != blank
    assign has_content = true
  endif
  if section.settings.rank != blank
    assign has_content = true
  endif
  if section.settings.title != blank
    assign has_content = true
  endif
  if section.settings.text != blank
    assign has_content = true
  endif
  if section.settings.button_text != blank
    assign has_content = true
  endif

  assign heading_tag = 'h2'
  unless section.settings.heading_tag == 'automatic' or section.settings.heading_tag == blank
    assign heading_tag = section.settings.heading_tag
  endunless

  assign button_style = section.settings.button_style
  if button_style == 'btn--text' and section.settings.button_show_arrow
    assign button_style = button_style | append: ' btn--text-no-underline'
  endif

  comment
    The badge is a fixed-width element, so the browser only ever needs it at the
    configured width (doubled for retina) — not a full viewport-width candidate.
  endcomment
  assign badge_width_2x = section.settings.badge_width | times: 2
  capture badge_sizes
    echo section.settings.badge_width | append: 'px'
  endcapture
-%}

{%- style -%}
  #AwardBadge--{{ section.id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
    --award-badge-width: {{ section.settings.badge_width }}px;
    --award-badge-gap: {{ section.settings.gap }}px;
  }

  #AwardBadge--{{ section.id }} .award-badge__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--award-badge-gap);
  }

  #AwardBadge--{{ section.id }} .award-badge__inner--image-right {
    flex-direction: row-reverse;
  }

  #AwardBadge--{{ section.id }} .award-badge__inner--stacked {
    flex-direction: column;
    text-align: center;
  }

  #AwardBadge--{{ section.id }} .award-badge__media {
    flex: 0 0 auto;
    width: min(var(--award-badge-width), 100%);
  }

  #AwardBadge--{{ section.id }} .award-badge__content {
    flex: 1 1 320px;
    min-width: 0;
    max-width: 620px;
  }

  #AwardBadge--{{ section.id }} .award-badge__inner--stacked .award-badge__content {
    flex: 0 1 auto;
  }

  #AwardBadge--{{ section.id }} .award-badge__content .hero__subheading {
    --block-padding-bottom: 8px;
  }

  #AwardBadge--{{ section.id }} .award-badge__content .award-badge__rank {
    --block-padding-bottom: 4px;
    display: block;
    line-height: 1;
  }

  {%- comment -%}
    The prefix rides along at a fraction of the number's size so "No." reads as a
    label and 1127 carries the weight — one em-relative rule covers every size option.
  {%- endcomment -%}
  #AwardBadge--{{ section.id }} .award-badge__rank-prefix {
    font-size: 0.55em;
    letter-spacing: 0.04em;
    opacity: 0.65;
    margin-right: 0.18em;
  }

  #AwardBadge--{{ section.id }} .award-badge__content .hero__title {
    --block-padding-bottom: 12px;
  }

  #AwardBadge--{{ section.id }} .award-badge__content .hero__rte {
    --block-padding-bottom: 16px;
  }

  {%- comment -%}
    Last child sheds its trailing space so the badge and copy stay optically
    centred against each other. Declared last: it ties on specificity with the
    per-element rules above and must win.
  {%- endcomment -%}
  #AwardBadge--{{ section.id }} .award-badge__content > :last-child {
    --block-padding-bottom: 0px;
  }

  #AwardBadge--{{ section.id }} .award-badge__title {
    margin-top: 0;
  }

  #AwardBadge--{{ section.id }} .award-badge__placeholder {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    opacity: 0.35;
  }

  @media screen and (max-width: 749px) {
    #AwardBadge--{{ section.id }} .award-badge__inner,
    #AwardBadge--{{ section.id }} .award-badge__inner--image-right {
      flex-direction: column;
      text-align: center;
      gap: {{ section.settings.gap | at_most: 32 }}px;
    }
  }
{%- endstyle -%}

<section
  id="AwardBadge--{{ section.id }}"
  class="award-badge section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="award-badge"
>
  <div class="{{ section.settings.width }}">
    <div class="award-badge__inner award-badge__inner--{{ layout }}">
      {%- assign animation_order = animation_order | plus: 1 -%}
      <div
        class="award-badge__media"
        data-aos="hero"
        data-aos-anchor="{{ animation_anchor }}"
        data-aos-order="{{ animation_order }}"
      >
        {%- if section.settings.badge_link != blank -%}
          <a href="{{ section.settings.badge_link }}" class="award-badge__link">
        {%- endif -%}

        {%- if section.settings.badge != blank -%}
          {%- render 'image',
            image: section.settings.badge,
            width: badge_width_2x,
            sizes: badge_sizes,
            widths: '120, 180, 240, 360, 480, 720',
            alt: section.settings.badge_alt,
            show_backfill: false
          -%}
        {%- else -%}
          {%- comment -%}
            Keeps the badge slot visible in the editor and in local preview before
            the seal has been picked, so the layout can be judged as it will ship.
          {%- endcomment -%}
          {{ 'image' | placeholder_svg_tag: 'award-badge__placeholder svg-placeholder' }}
        {%- endif -%}

        {%- if section.settings.badge_link != blank -%}
          </a>
        {%- endif -%}
      </div>

      {%- if has_content -%}
        <div class="award-badge__content {{ section.settings.align_text }}">
          {%- if section.settings.subheading != blank -%}
            {%- assign animation_order = animation_order | plus: 1 -%}
            <p
              class="hero__subheading block-padding"
              data-aos="hero"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-order="{{ animation_order }}"
            >
              {{ section.settings.subheading | escape }}
            </p>
          {%- endif -%}

          {%- if section.settings.rank != blank -%}
            {%- assign animation_order = animation_order | plus: 1 -%}
            <p
              class="award-badge__rank hero__title {{ section.settings.rank_font_size }} block-padding"
              data-aos="hero"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-order="{{ animation_order }}"
            >
              {%- if section.settings.rank_prefix != blank -%}
                <span class="award-badge__rank-prefix">{{ section.settings.rank_prefix | escape }}</span>
              {%- endif -%}
              {{- section.settings.rank | escape -}}
            </p>
          {%- endif -%}

          {%- if section.settings.title != blank -%}
            {%- assign animation_order = animation_order | plus: 1 -%}
            <{{ heading_tag }}
              class="award-badge__title hero__title {{ section.settings.heading_font_size }} block-padding"
              data-aos="hero"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-order="{{ animation_order }}"
            >
              {{ section.settings.title | escape }}
            </{{ heading_tag }}>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            {%- assign animation_order = animation_order | plus: 1 -%}
            <div
              class="hero__rte {{ section.settings.text_font_size }} block-padding"
              data-aos="hero"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-order="{{ animation_order }}"
            >
              {{ section.settings.text }}
            </div>
          {%- endif -%}

          {%- if section.settings.button_text != blank -%}
            {%- assign animation_order = animation_order | plus: 1 -%}
            <div
              class="award-badge__button block-padding"
              data-aos="hero"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-order="{{ animation_order }}"
            >
              <a
                href="{{ section.settings.button_url | default: '#!' }}"
                class="btn {{ button_style }} {{ section.settings.button_size }} {{ section.settings.button_type }}"
              >
                <span>{{ section.settings.button_text | escape }}</span>

                {%- if section.settings.button_show_arrow -%}
                  {%- render 'icon-nav-arrow-right' -%}
                {%- endif -%}
              </a>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Award badge",
  "settings": [
    {
      "type": "image_picker",
      "id": "badge",
      "label": "Badge image",
      "info": "Pick the award seal from your Files library. A transparent .png around 600 x 600px works best."
    },
    {
      "type": "text",
      "id": "badge_alt",
      "label": "Badge alt text",
      "default": "Inc. 5000 Fastest-Growing Private Companies honoree",
      "info": "Describes the badge for screen readers and search engines."
    },
    {
      "type": "url",
      "id": "badge_link",
      "label": "Badge link",
      "info": "Optional. Link the seal to the award listing or announcement."
    },
    {
      "type": "range",
      "id": "badge_width",
      "min": 80,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Badge width",
      "default": 160
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "2026 Honoree"
    },
    {
      "type": "text",
      "id": "rank",
      "label": "Ranking number",
      "default": "1127",
      "info": "Just the number — the prefix below is added automatically. Leave empty to hide."
    },
    {
      "type": "text",
      "id": "rank_prefix",
      "label": "Ranking prefix",
      "default": "No."
    },
    {
      "type": "select",
      "id": "rank_font_size",
      "label": "Ranking size",
      "default": "heading-large",
      "options": [
        { "value": "heading-mini", "label": "Mini" },
        { "value": "heading-x-small", "label": "Extra small" },
        { "value": "heading-small", "label": "Small" },
        { "value": "heading-medium", "label": "Medium" },
        { "value": "heading-large", "label": "Large" },
        { "value": "heading-x-large", "label": "Extra large" }
      ]
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Inc. 5000 Fastest-Growing Companies"
    },
    {
      "type": "select",
      "id": "heading_font_size",
      "label": "Heading size",
      "default": "heading-small",
      "options": [
        { "value": "heading-mini", "label": "Mini" },
        { "value": "heading-x-small", "label": "Extra small" },
        { "value": "heading-small", "label": "Small" },
        { "value": "heading-medium", "label": "Medium" },
        { "value": "heading-large", "label": "Large" },
        { "value": "heading-x-large", "label": "Extra large" }
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We're honoured to be named one of America's 5,000 fastest-growing private companies — thank you for growing with us.</p>"
    },
    {
      "type": "select",
      "id": "text_font_size",
      "label": "Text size",
      "default": "body-medium",
      "options": [
        { "value": "body-x-small", "label": "Extra small" },
        { "value": "body-small", "label": "Small" },
        { "value": "body-medium", "label": "Medium" },
        { "value": "body-large", "label": "Large" },
        { "value": "body-x-large", "label": "Extra large" }
      ]
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Text"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "button_type",
      "label": "Color",
      "default": "btn--primary",
      "options": [
        { "value": "btn--black", "label": "Black" },
        { "value": "btn--white", "label": "White" },
        { "value": "btn--primary", "label": "Primary" },
        { "value": "btn--secondary", "label": "Secondary" }
      ]
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Size",
      "default": "btn--small",
      "options": [
        { "label": "Small", "value": "btn--small" },
        { "label": "Medium", "value": "" },
        { "label": "Large", "value": "btn--large" }
      ]
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style",
      "default": "btn--text",
      "options": [
        { "label": "Solid", "value": "btn--solid" },
        { "label": "Outline", "value": "btn--outline" },
        { "label": "Text", "value": "btn--text" }
      ]
    },
    {
      "type": "checkbox",
      "id": "button_show_arrow",
      "label": "Show arrow",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Badge position",
      "default": "image-left",
      "options": [
        { "value": "image-left", "label": "Badge left" },
        { "value": "image-right", "label": "Badge right" },
        { "value": "stacked", "label": "Badge above text" }
      ]
    },
    {
      "type": "select",
      "id": "align_text",
      "label": "Text alignment",
      "default": "text-left",
      "options": [
        { "value": "text-left", "label": "Left" },
        { "value": "text-center", "label": "Center" },
        { "value": "text-right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Space between badge and text",
      "default": 40
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wrapper",
      "options": [
        { "value": "wrapper--full-padded", "label": "Full width padded" },
        { "value": "wrapper", "label": "Page width" },
        { "value": "wrapper--narrow", "label": "Narrow" }
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme_1",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom",
      "default": 40
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading SEO tag",
      "default": "automatic",
      "options": [
        { "value": "automatic", "label": "Automatic" },
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Award badge",
      "category": "Text"
    }
  ]
}
{% endschema %}
