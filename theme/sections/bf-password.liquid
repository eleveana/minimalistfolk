{%- comment -%}
  Black Friday password page: the storefront-closed screen shown while the store is
  password protected (Online Store → Preferences). The early access code field (Shopify's
  store password) sits at the top, with the email sign-up below for people without a code.
  Sign-ups become customers with marketing consent, tagged with the setting below.
{%- endcomment -%}
<div class="bf-pw">
  <div class="bf-pw__inner">
    {%- if section.settings.logo != blank -%}
      {%- assign logo_style = 'width: ' | append: section.settings.logo_width | append: 'px' -%}
      {{ section.settings.logo | image_url: width: 800 | image_tag: class: 'bf-pw__logo', alt: shop.name, loading: 'eager', style: logo_style }}
    {%- else -%}
      <p class="bf-pw__shop">{{ shop.name }}</p>
    {%- endif -%}

    {%- if section.settings.pill != blank -%}<span class="bf-pw__pill">{{ section.settings.pill }}</span>{%- endif -%}
    <h1 class="bf-pw__title">{{ section.settings.title_1 }} <span>{{ section.settings.title_2 }}</span></h1>
    {%- if section.settings.text != blank -%}<p class="bf-pw__sub">{{ section.settings.text }}</p>{%- endif -%}

    <div class="bf-pw__code">
      {%- if section.settings.code_title != blank -%}<p class="bf-pw__code-title">{{ section.settings.code_title }}</p>{%- endif -%}
      {%- form 'storefront_password', class: 'bf-pw__field' -%}
        <label class="visually-hidden" for="bf-pw-password">{{ section.settings.code_placeholder }}</label>
        <input id="bf-pw-password" type="password" name="password" placeholder="{{ section.settings.code_placeholder | escape }}" autocomplete="off" autocapitalize="off" spellcheck="false">
        <button type="submit">{{ section.settings.code_button }}</button>
        {%- if form.errors -%}<p class="bf-pw__error" role="alert">{{ section.settings.code_error }}</p>{%- endif -%}
      {%- endform -%}
    </div>

    <div class="bf-pw__signup">
      {%- form 'customer', id: 'bf-pw-signup', class: 'bf-pw__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="bf-pw__thanks" role="status">
            <strong>{{ section.settings.thanks_title }}</strong>
            {{ section.settings.thanks_text }}
          </p>
        {%- else -%}
          {%- if section.settings.lead != blank -%}<p class="bf-pw__lead">{{ section.settings.lead }}</p>{%- endif -%}
          <input type="hidden" name="contact[tags]" value="newsletter, {{ section.settings.tag | escape }}">
          <div class="bf-pw__field">
            <label class="visually-hidden" for="bf-pw-email">Email</label>
            <input id="bf-pw-email" type="email" name="contact[email]" placeholder="Your email" autocomplete="email" required>
            <button type="submit">{{ section.settings.button }}</button>
          </div>
          {%- if form.errors -%}<p class="bf-pw__error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>

    <p class="bf-pw__admin">Store owner? <a href="/admin">Log in here</a></p>
  </div>
</div>

<style>
  #password .bf-pw {
    min-height: 100vh; min-height: 100svh; background: #000; color: #fff9e1; font-family: var(--FONT-STACK-BODY);
    display: flex; align-items: center; justify-content: center; padding: 40px 16px;
  }
  .bf-pw__inner { width: 100%; max-width: 760px; text-align: center; }
  .bf-pw__logo { max-width: 70%; height: auto; margin: 0 auto 28px; display: block; }
  .bf-pw__shop { margin: 0 0 28px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .bf-pw__pill {
    display: inline-block; padding: 8px 16px; border-radius: 999px; background: #8b904d; color: #fff;
    font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase;
  }
  .bf-pw__title {
    margin: 16px 0 8px; font-family: var(--FONT-STACK-HEADING); font-weight: 400; text-transform: uppercase;
    line-height: .9; font-size: clamp(64px, 14vw, 170px); color: #fff9e1;
  }
  .bf-pw__title span { color: #a898c5; }
  .bf-pw__sub { margin: 0 auto 28px; font-size: clamp(16px, 1.6vw, 20px); line-height: 1.45; max-width: 36ch; }
  .bf-pw__lead { margin: 0 0 14px; font-size: 16px; }
  .bf-pw__field { display: flex; gap: 10px; max-width: 520px; margin: 0 auto; flex-wrap: wrap; }
  .bf-pw__field input {
    flex: 1; min-width: 0; padding: 16px 20px; border-radius: 999px; border: 1.5px solid #fff9e1;
    background: transparent; color: #fff9e1; font: inherit; font-size: 16px;
  }
  .bf-pw__field input::placeholder { color: rgba(255, 249, 225, .6); }
  .bf-pw__field button {
    padding: 16px 26px; border-radius: 999px; border: 0; background: #8b904d; color: #fff; cursor: pointer;
    font: 600 13px/1 var(--FONT-STACK-BODY); letter-spacing: .12em; text-transform: uppercase; white-space: nowrap;
  }
  .bf-pw__thanks { font-size: 18px; line-height: 1.5; margin: 0; }
  .bf-pw__thanks strong {
    display: block; font-family: var(--FONT-STACK-HEADING); font-weight: 400; font-size: 36px;
    text-transform: uppercase; color: #ecb935;
  }
  .bf-pw__error { width: 100%; color: #de8d9b; margin: 12px 0 0; font-size: 14px; }
  .bf-pw__code { max-width: 520px; margin: 0 auto; }
  .bf-pw__signup { margin: 44px auto 0; padding-top: 28px; border-top: 1px solid rgba(255, 249, 225, .2); max-width: 520px; }
  .bf-pw__signup .bf-pw__field button { background: transparent; border: 1.5px solid #fff9e1; color: #fff9e1; }
  .bf-pw__code-title { margin: 0 0 12px; font-family: var(--FONT-STACK-HEADING); text-transform: uppercase; font-size: 24px; color: #ecb935; }
  .bf-pw__admin { margin: 32px 0 0; font-size: 12px; color: rgba(255, 249, 225, .6); }
  #password .bf-pw__admin a { color: #fff9e1; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 600px) {
    .bf-pw__field { flex-direction: column; }
  }
</style>

{% schema %}
{
  "name": "Black Friday password",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 80, "max": 400, "step": 10, "unit": "px", "default": 220 },
    { "type": "text", "id": "pill", "label": "Pill", "default": "Early access" },
    { "type": "text", "id": "title_1", "label": "Heading (cream)", "default": "Black" },
    { "type": "text", "id": "title_2", "label": "Heading (purple)", "default": "Friday" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "40% off everything. Doors open tomorrow, Nov 20 at 8am PT." },
    { "type": "header", "content": "Sign-up" },
    { "type": "text", "id": "lead", "label": "Text above the form", "default": "Sign up to be first in line when the doors open." },
    { "type": "text", "id": "button", "label": "Button", "default": "Get early access" },
    { "type": "text", "id": "tag", "label": "Customer tag", "default": "bf-early-access", "info": "Added to everyone who signs up here." },
    { "type": "text", "id": "thanks_title", "label": "Thank-you heading", "default": "You're on the list!" },
    { "type": "text", "id": "thanks_text", "label": "Thank-you text", "default": "Watch your inbox — the sale opens tomorrow at 8am PT." },
    { "type": "header", "content": "Early access code", "info": "The code is the store password (Online Store → Preferences)." },
    { "type": "text", "id": "code_title", "label": "Heading", "default": "Have an early access code?" },
    { "type": "text", "id": "code_placeholder", "label": "Placeholder", "default": "Enter your code" },
    { "type": "text", "id": "code_button", "label": "Button", "default": "Shop now" },
    { "type": "text", "id": "code_error", "label": "Wrong code message", "default": "That code doesn't look right. Check your email and try again." }
  ],
  "presets": [{ "name": "Black Friday password" }],
  "enabled_on": { "templates": ["password"] }
}
{% endschema %}
