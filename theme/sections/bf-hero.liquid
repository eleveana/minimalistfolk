{%- comment -%}
  Black Friday hero: pills, 40% sticker, giant title, countdown, tilted photo
  cards (pick products or images) and a marquee strip.
  Sets html[data-bf-phase] ("pre" / "live") that the other bf-* sections read.
{%- endcomment -%}
{{ 'black-friday.css' | asset_url | stylesheet_tag }}
<script>
  (function () {
    var s = Date.parse({{ section.settings.start | json }});
    document.documentElement.setAttribute('data-bf-phase', Date.now() < s ? 'pre' : 'live');
  })();
</script>

{%- liquid
  assign accents = '#ecb935,#de8d9b,#d1def9,#dc954d' | split: ','
  assign photo_accents = '#ecb935,#de8d9b,#d1def9,#8b904d' | split: ','
  assign photo_blocks = section.blocks | where: 'type', 'photo'
-%}

<div class="bf" data-bf-hero data-start="{{ section.settings.start | escape }}" data-end="{{ section.settings.end | escape }}" data-countdown-to="{{ section.settings.countdown_to }}">
  <section class="bf-hero">
    <div class="bf__wrap">
      <div class="bf-hero__pills">
        {%- if section.settings.pill_1 != blank -%}<span class="bf-pill bf-pill--solid bf__eyebrow">{{ section.settings.pill_1 }}</span>{%- endif -%}
        {%- if section.settings.pill_2 != blank -%}<span class="bf-pill bf__eyebrow">{{ section.settings.pill_2 }}</span>{%- endif -%}
      </div>

      {%- if section.settings.sticker_big != blank -%}
        <div class="bf-sticker">
          <span class="bf-sticker__big">{{ section.settings.sticker_big }}</span>
          <span class="bf-sticker__small">{{ section.settings.sticker_small }}</span>
        </div>
      {%- endif -%}
      <h1 class="bf__display bf-hero__title">{{ section.settings.title_1 }} <span>{{ section.settings.title_2 }}</span></h1>

      <div class="bf-hero__row">
        <div>
          <p class="bf__display bf-hero__sub">
            {{ section.settings.sub_1 }} <span class="c2">{{ section.settings.sub_2 }}</span> <span class="c3">{{ section.settings.sub_3 }}</span>
          </p>
          <div class="bf-hero__actions">
            <a class="bf-btn" href="#bf-shop">
              <span data-bf-pre>{{ section.settings.button_pre }}</span>
              <span data-bf-live>{{ section.settings.button_live }}</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
            {%- if section.settings.link_text != blank -%}
              <a class="bf-link" href="#bf-types">{{ section.settings.link_text }}</a>
            {%- endif -%}
          </div>
        </div>

        <div class="bf-countdown">
          <span class="bf__eyebrow bf-countdown__label">
            {%- if section.settings.countdown_to == 'end' -%}
              {{ section.settings.countdown_live }}
            {%- else -%}
              <span data-bf-pre>{{ section.settings.countdown_pre }}</span>
              <span data-bf-live>{{ section.settings.countdown_live }}</span>
            {%- endif -%}
          </span>
          <div class="bf-countdown__tiles" data-bf-countdown>
            <div class="bf-tile" style="background: {{ accents[0] }}"><span class="bf-tile__num" data-bf-days>00</span><span class="bf-tile__unit">Days</span></div>
            <div class="bf-tile" style="background: {{ accents[1] }}"><span class="bf-tile__num" data-bf-hours>00</span><span class="bf-tile__unit">Hours</span></div>
            <div class="bf-tile" style="background: {{ accents[2] }}"><span class="bf-tile__num" data-bf-minutes>00</span><span class="bf-tile__unit">Minutes</span></div>
            <div class="bf-tile" style="background: {{ accents[3] }}"><span class="bf-tile__num" data-bf-seconds>00</span><span class="bf-tile__unit">Seconds</span></div>
          </div>
          <p class="bf-countdown__done" data-bf-done hidden>{{ section.settings.ended_message }}</p>
        </div>
      </div>

      <div class="bf-hero__photos">
        {%- if photo_blocks.size > 0 -%}
          {%- for block in photo_blocks limit: 4 -%}
            {%- liquid
              assign accent = block.settings.accent | default: photo_accents[forloop.index0]
              assign p = block.settings.product
              assign url = block.settings.link
              if url == blank and p != blank
                assign url = p.url
              endif
              assign tag = 'div'
              if url != blank
                assign tag = 'a'
              endif
            -%}
            <{{ tag }} class="bf-photo" style="--accent: {{ accent }}"{% if tag == 'a' %} href="{{ url }}"{% endif %} {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'eager', sizes: '(min-width: 750px) 25vw, 50vw', alt: block.settings.image.alt | escape }}
              {%- elsif p.featured_media -%}
                {{ p.featured_media | image_url: width: 700 | image_tag: loading: 'eager', sizes: '(min-width: 750px) 25vw, 50vw', alt: p.title | escape }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}
              {%- if block.settings.label != blank -%}<span class="bf-photo__label bf__eyebrow">{{ block.settings.label }}</span>{%- endif -%}
            </{{ tag }}>
          {%- endfor -%}
        {%- elsif collection.products.size > 0 -%}
          {%- for product in collection.products limit: 4 -%}
            <a class="bf-photo" style="--accent: {{ photo_accents[forloop.index0] }}" href="{{ product.url }}">
              {%- if product.featured_media -%}
                {{ product.featured_media | image_url: width: 700 | image_tag: loading: 'eager', sizes: '(min-width: 750px) 25vw, 50vw', alt: product.title | escape }}
              {%- endif -%}
              {%- if section.settings.photo_label != blank -%}<span class="bf-photo__label bf__eyebrow">{{ section.settings.photo_label }}</span>{%- endif -%}
            </a>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- assign marquee_items = section.settings.marquee | split: ',' -%}
  {%- if marquee_items.size > 0 -%}
    <div class="bf-marquee" aria-hidden="true">
      <div class="bf-marquee__track">
        {%- for i in (1..8) -%}
          {%- for item in marquee_items -%}<span class="bf-marquee__item">{{ item | strip }}</span>{%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

<script src="{{ 'black-friday.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Black Friday hero",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Sale dates" },
    { "type": "text", "id": "start", "label": "Sale starts", "default": "2026-11-20T00:00:00-08:00", "info": "Format 2026-11-20T00:00:00-08:00 (-08:00 = Pacific). Before this the countdown says 'starts in'; after, it counts to the end date." },
    { "type": "text", "id": "end", "label": "Sale ends", "default": "2026-12-01T23:59:59-08:00" },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "pill_1", "label": "Pill 1", "default": "40% off sitewide" },
    { "type": "text", "id": "pill_2", "label": "Pill 2", "default": "Nov 20 to Dec 1" },
    { "type": "text", "id": "sticker_big", "label": "Sticker (big text)", "default": "40%", "info": "Round sticker next to the title. Leave empty to hide." },
    { "type": "text", "id": "sticker_small", "label": "Sticker (small text)", "default": "Off sitewide" },
    { "type": "text", "id": "title_1", "label": "Title (cream)", "default": "Black" },
    { "type": "text", "id": "title_2", "label": "Title (yellow)", "default": "Friday" },
    { "type": "text", "id": "sub_1", "label": "Subheading part 1", "default": "40% off everything." },
    { "type": "text", "id": "sub_2", "label": "Subheading part 2 (pink)", "default": "Sitewide." },
    { "type": "text", "id": "sub_3", "label": "Subheading part 3 (blue)", "default": "No code needed." },
    { "type": "text", "id": "button_pre", "label": "Button before the sale", "default": "Preview the sale" },
    { "type": "text", "id": "button_live", "label": "Button during the sale", "default": "Shop the sale" },
    { "type": "text", "id": "link_text", "label": "Secondary link", "default": "Shop by type" },
    {
      "type": "select", "id": "countdown_to", "label": "Countdown",
      "options": [
        { "value": "end", "label": "Always count to the sale end" },
        { "value": "start_then_end", "label": "Count to the start, then to the end" }
      ],
      "default": "end"
    },
    { "type": "text", "id": "countdown_live", "label": "Countdown label (to the end)", "default": "Black Friday ends in" },
    { "type": "text", "id": "countdown_pre", "label": "Countdown label (to the start)", "default": "Black Friday starts in", "visible_if": "{{ section.settings.countdown_to == 'start_then_end' }}" },
    { "type": "text", "id": "ended_message", "label": "Message after the sale", "default": "Black Friday has ended" },
    { "type": "text", "id": "photo_label", "label": "Label on photo cards", "default": "40% off", "info": "Used when no photo cards are added and the best sellers show instead." },
    { "type": "header", "content": "Marquee" },
    { "type": "text", "id": "marquee", "label": "Marquee messages", "info": "Separate with commas.", "default": "Black Friday, 40% off sitewide, No code needed, Ends Dec 1" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo card",
      "limit": 4,
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Uses the product's photo and links to it." },
        { "type": "image_picker", "id": "image", "label": "Custom image", "info": "Optional. Replaces the product photo." },
        { "type": "url", "id": "link", "label": "Custom link", "info": "Optional. Replaces the product link." },
        { "type": "text", "id": "label", "label": "Label", "default": "40% off" },
        { "type": "color", "id": "accent", "label": "Shadow color" }
      ]
    }
  ],
  "presets": [{ "name": "Black Friday hero" }]
}
{% endschema %}
