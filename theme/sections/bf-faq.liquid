{%- comment -%}
  Black Friday FAQ: big heading + help links on the left, numbered question cards
  on the right. Native <details>, so it works without JavaScript.
{%- endcomment -%}
{{ 'black-friday.css' | asset_url | stylesheet_tag }}

{%- assign accents = '#ecb935,#de8d9b,#d1def9,#8b904d' | split: ',' -%}

<div class="bf">
  <section class="bf-faq">
    <div class="bf__wrap bf-faq__inner">
      <div class="bf-faq__intro">
        {%- if section.settings.eyebrow != blank -%}<span class="bf-pill bf-pill--solid bf__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="bf__display bf-faq__title">{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="bf-faq__text">{{ section.settings.text }}</p>{%- endif -%}
        <div class="bf-faq__links">
          {%- if section.settings.link_1_text != blank and section.settings.link_1_url != blank -%}<a class="bf-link" href="{{ section.settings.link_1_url }}">{{ section.settings.link_1_text }}</a>{%- endif -%}
          {%- if section.settings.link_2_text != blank and section.settings.link_2_url != blank -%}<a class="bf-link" href="{{ section.settings.link_2_url }}">{{ section.settings.link_2_text }}</a>{%- endif -%}
        </div>
      </div>

      <div class="bf-faq__list">
        {%- for block in section.blocks -%}
          {%- assign accent_index = forloop.index0 | modulo: 4 -%}
          <details class="bf-q" style="--accent: {{ block.settings.color | default: accents[accent_index] }}"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
            <summary class="bf-q__summary">
              <span class="bf-q__num bf__display">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="bf-q__title bf__display">{{ block.settings.question }}</span>
              <span class="bf-q__icon" aria-hidden="true"></span>
            </summary>
            <div class="bf-q__answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Black Friday FAQ",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Pill", "default": "Good to know" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Black Friday questions" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The short version: 40% off everything, no code, through December 1." },
    { "type": "text", "id": "link_1_text", "label": "Link 1", "default": "All FAQs" },
    { "type": "url", "id": "link_1_url", "label": "Link 1 URL" },
    { "type": "text", "id": "link_2_text", "label": "Link 2", "default": "Contact us" },
    { "type": "url", "id": "link_2_url", "label": "Link 2 URL" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false },
        { "type": "color", "id": "color", "label": "Color" }
      ]
    }
  ],
  "presets": [{ "name": "Black Friday FAQ" }]
}
{% endschema %}
