<!-- /sections/collection-image-with-title.liquid -->
{%- liquid
  assign banner_layout = section.settings.banner_layout
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign show_text_background = section.settings.show_text_background
  assign overlay_type = section.settings.overlay_type
  assign opacity_overlay = false
  assign text_underlay = false
  assign show_header_backdrop = false
  assign show_title = section.settings.show_title
  assign show_description = section.settings.show_description
  assign title = collection.title
  assign description = collection.description

  case overlay_type
    when 'opacity'
      assign opacity_overlay = true
    when 'text'
      assign text_underlay = true
  endcase

  if description == blank
    assign show_description = false
  endif

  assign selected_color_scheme = section.settings.color_scheme | strip
  assign scheme_bg_color = settings.color_schemes[selected_color_scheme].settings.section_bg

  assign hero_transparent = true
  if show_text_background and scheme_bg_color.alpha != 0.0 or scheme_bg_color != blank
    assign hero_transparent = false
  endif

  if hero_transparent and text_underlay
    assign show_header_backdrop = true
  endif

  comment
    Time-based label: before switch time show "Label", after it show
    "Label (after switch time)", and after the hide time show nothing.
    Times are Unix epochs so the swap needs no manual edit on launch day.
    Storefront page caching can delay each flip by a few minutes.
  endcomment
  assign hero_label = section.settings.label_text
  assign now_epoch = 'now' | date: '%s' | plus: 0
  if section.settings.label_swap_epoch != blank
    assign swap_epoch = section.settings.label_swap_epoch | plus: 0
    if now_epoch >= swap_epoch
      assign hero_label = section.settings.label_text_2
    endif
  endif
  if section.settings.label_hide_epoch != blank
    assign hide_epoch = section.settings.label_hide_epoch | plus: 0
    if now_epoch >= hide_epoch
      assign hero_label = blank
    endif
  endif
  comment
    On the shared collection template this section renders for every
    collection, so a label can be scoped to a single collection handle.
  endcomment
  if section.settings.label_collection != blank and collection.handle != section.settings.label_collection
    assign hero_label = blank
  endif
-%}

{%- render 'stylesheet', name: 'collection-image-with-title.css' -%}

{%- style -%}
  .collection-image-with-title {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
  }
  .collection-image-with-title .hero__label {
    display: inline-block;
    align-self: flex-start;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 100px;
    background: var(--text);
    color: var(--bg);
    margin-bottom: 14px;
  }
{%- endstyle -%}

{%- capture collection_content -%}
  {%- if show_title or show_description -%}
    <div class="hero__content__wrapper{% if show_header_backdrop %} backdrop--linear{% endif %} {{ section.settings.flex_align }}{% if banner_layout == 'overlay' %} frame__item{% endif %}">
      <div class="hero__content{% if text_underlay %} backdrop--radial{% endif %}{% if hero_transparent %} hero__content--transparent{% endif %}">
        {%- if hero_label != blank -%}
          <span class="hero__label">{{ hero_label }}</span>
        {%- endif -%}

        {%- if show_title -%}
          <h1 class="hero__title h3">
            {{ title }}

            {%- render 'superscript', superscript_collection: collection -%}
          </h1>
        {%- endif -%}

        {%- if description != blank and show_description -%}
          <div class="hero__description rte">{{ description }}</div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- capture image_overlay -%}
  {%- if opacity_overlay -%}
    <div class="image-overlay"></div>
  {%- endif -%}
{%- endcapture -%}

<section
  class="collection-image-with-title section-padding {{ color_scheme }}{% unless section.settings.show_image and collection.image and banner_layout != 'split' %} prevent-transparent-header{% endunless %}"
  data-section-id="{{ section.id }}"
  data-section-type="collection-image-with-title"
>
  {%- if banner_layout == 'split' -%}
    {%- comment -%}
      Split: text left (breadcrumbs, eyebrow, title, description), two photos right.
      Photos are the collection image (if any) then the first products' photos, so every
      collection gets a header without extra setup. The eyebrow comes from the collection
      metafield custom.eyebrow, falling back to the timed label above.
    {%- endcomment -%}
    {%- liquid
      assign use_collection_image = false
      if collection.image and section.settings.show_image
        assign use_collection_image = true
      endif
      assign eyebrow = collection.metafields.custom.eyebrow | default: hero_label
    -%}
    <div class="collection-split">
      <div class="collection-split__text">
        <nav class="collection-split__crumbs" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
          <span aria-hidden="true">/</span>
          <a href="{{ routes.collections_url }}">Shop</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{{ title }}</span>
        </nav>
        {%- if eyebrow != blank -%}
          <p class="collection-split__eyebrow">{{ eyebrow }}</p>
        {%- endif -%}
        {%- if show_title -%}
          <h1 class="collection-split__title">
            {{- title -}}
            {%- render 'superscript', superscript_collection: collection -%}
          </h1>
        {%- endif -%}
        {%- if description != blank and show_description -%}
          <div class="collection-split__description rte">{{ description }}</div>
        {%- endif -%}
      </div>
      {%- comment -%}
        Pool of up to 12 photos (collection image first, then product photos). The first 3
        render normally as the no-JS fallback; the rest wait in <template> tags so they don't
        download. The inline script right after shuffles the pool and keeps 3, so each visit
        shows a different mix — done in the browser because Shopify caches the page HTML.
      {%- endcomment -%}
      {%- capture split_photos -%}
        {%- assign split_count = 0 -%}
        {%- if use_collection_image -%}
          <div class="collection-split__photo">
            {{ collection.image | image_url: width: 700 | image_tag: loading: 'eager', sizes: '(min-width: 990px) 220px, 30vw', alt: '' }}
          </div>
          {%- assign split_count = 1 -%}
        {%- endif -%}
        {%- for p in collection.products limit: 24 -%}
          {%- if split_count >= 12 -%}{%- break -%}{%- endif -%}
          {%- if p.featured_media == blank -%}{%- continue -%}{%- endif -%}
          {%- if use_collection_image and p.featured_media.preview_image.src == collection.image.src -%}{%- continue -%}{%- endif -%}
          {%- if split_count >= 3 -%}<template>{%- endif -%}
          <div class="collection-split__photo">
            {{ p.featured_media | image_url: width: 700 | image_tag: loading: 'eager', sizes: '(min-width: 990px) 220px, 30vw', alt: '' }}
          </div>
          {%- if split_count >= 3 -%}</template>{%- endif -%}
          {%- assign split_count = split_count | plus: 1 -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if split_photos != blank -%}
        <div class="collection-split__media">{{ split_photos }}</div>
        <script>
          (function () {
            var media = document.currentScript.previousElementSibling;
            var pool = Array.prototype.map.call(media.children, function (el) {
              return el.tagName === 'TEMPLATE' ? el.content.firstElementChild : el;
            }).filter(Boolean);
            if (pool.length <= 3) return;
            for (var i = pool.length - 1; i > 0; i--) {
              var j = Math.floor(Math.random() * (i + 1));
              var t = pool[i]; pool[i] = pool[j]; pool[j] = t;
            }
            media.textContent = '';
            pool.slice(0, 3).forEach(function (el) { media.appendChild(el); });
          })();
        </script>
      {%- endif -%}
    </div>
  {%- elsif collection.image and section.settings.show_image -%}
    {%- if banner_layout == 'inline' -%}
      <div class="collection__image-inline">
    {%- endif -%}

    <div
      class="collection__image {{ section.settings.height }} {{ section.settings.mobile_height }}{% if banner_layout == 'overlay' %} frame{% endif %}"
      data-overlay-header
    >
      {%- if banner_layout == 'overlay' -%}
        {{ collection_content }}
      {%- endif -%}

      {{ image_overlay }}

      <div class="hero__image{% if banner_layout == 'overlay' %} frame__item{% endif %}">
        {%- render 'image-hero',
          image: collection.image,
          desktop_height: section.settings.height,
          mobile_height: section.settings.mobile_height,
          loading: 'eager',
          fetchpriority: 'high',
          preload: true
        -%}
      </div>
    </div>

    {%- if banner_layout == 'inline' -%}
      <div class="collection__title-wrapper {{ section.settings.height }} {{ section.settings.mobile_height }}">
        {{ collection_content }}
      </div>
      </div>
    {%- endif -%}
  {%- else -%}
    {%- if show_title or show_description -%}
      <div class="collection__title collection__title--no-image {{ section.settings.flex_align }}">
        {%- if show_title -%}
          <h1 class="hero__title h3">
            {{ title }}

            {%- render 'superscript', superscript_collection: collection -%}
          </h1>
        {%- endif -%}

        {%- if description != blank and show_description -%}
          <div class="hero__description rte">{{ description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Image with title",
  "class": "section-overlay-header",
  "settings": [
    {
      "type": "header",
      "content": "Title and Description"
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Label",
      "info": "Optional pill shown above the title, e.g. \"Launching tomorrow\". Leave empty to hide."
    },
    {
      "type": "text",
      "id": "label_text_2",
      "label": "Label (after switch time)",
      "info": "Replaces the label once the switch time passes."
    },
    {
      "type": "text",
      "id": "label_swap_epoch",
      "label": "Label switch time (Unix epoch, UTC seconds)",
      "info": "e.g. 1784876400 = Jul 24 2026 12:00am PT. Leave empty to never switch."
    },
    {
      "type": "text",
      "id": "label_hide_epoch",
      "label": "Label hide time (Unix epoch, UTC seconds)",
      "info": "Label disappears entirely after this time. e.g. 1784912400 = Jul 24 2026 10:00am PT. Leave empty to never hide."
    },
    {
      "type": "text",
      "id": "label_collection",
      "label": "Show label only on this collection",
      "info": "Collection handle, e.g. halloween-2026. Leave empty to show the label on every collection using this template."
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show collection title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "select",
      "id": "flex_align",
      "label": "Text alignment",
      "default": "align--middle-left",
      "options": [
        {"value": "align--top-left", "label": "Top left"},
        {"value": "align--top-right", "label": "Top right"},
        {"value": "align--middle-left", "label": "Center left"},
        {"value": "align--middle-center", "label": "Center center"},
        {"value": "align--middle-right", "label": "Center right"},
        {"value": "align--bottom-left", "label": "Bottom left"},
        {"value": "align--bottom-right", "label": "Bottom right"}
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme_1",
      "label": "Color scheme"
    },
    {
      "type": "checkbox",
      "id": "show_text_background",
      "label": "Show text background",
      "default": false
    },
    {
      "type": "select",
      "id": "overlay_type",
      "label": "Overlay type",
      "default": "disabled",
      "options": [
        {"value": "disabled", "label": "Disabled"},
        {"value": "opacity", "label": "Opacity overlay"},
        {"value": "text", "label": "Text underlay"}
      ]
    },
    {
      "type": "header",
      "content": "Collection image"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show collection image",
      "default": true
    },
    {
      "type": "select",
      "id": "banner_layout",
      "label": "Layout",
      "info": "Text + photos shows 3 photos picked at random from the collection image and the first products' photos. Add a collection metafield custom.eyebrow for the small label above the title.",
      "default": "overlay",
      "options": [
        {"value": "inline", "label": "Inline"},
        {"value": "overlay", "label": "Overlay"},
        {"value": "split", "label": "Text + photos"}
      ]
    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "default": "screen-height-one-third",
      "options": [
        {"value": "image-height", "label": "Image height"},
        {"value": "screen-height-one-half", "label": "1/2 of screen"},
        {"value": "screen-height-one-third", "label": "1/3 of screen"},
        {"value": "five-fifty-height-hero ", "label": "550px"},
        {"value": "four-fifty-height-hero", "label": "450px"},
        {"value": "three-fifty-height-hero", "label": "350px"},
        {"value": "two-fifty-height-hero", "label": "250px"}
      ]
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Height",
      "default": "screen-height-one-half--mobile",
      "options": [
        {"value": "image-height--mobile", "label": "Image height"},
        {"value": "screen-height-one-half--mobile", "label": "1/2 of screen"},
        {"value": "screen-height-one-third--mobile", "label": "1/3 of screen"},
        {"value": "five-fifty-height-hero--mobile", "label": "550px"},
        {"value": "four-fifty-height-hero--mobile", "label": "450px"},
        {"value": "three-fifty-height-hero--mobile", "label": "350px"},
        {"value": "two-fifty-height-hero--mobile", "label": "250px"}
      ]
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom",
      "default": 0
    }
  ]
}
{% endschema %}
